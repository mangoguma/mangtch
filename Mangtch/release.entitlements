<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Developer ID release entitlements, applied by scripts/release.sh.
	     No App Sandbox: the Accessibility prompt and the perl subprocess that loads
	     MediaRemoteAdapter.framework don't work inside it. The upstream
	     boringNotch.entitlements (sandboxed) never took effect because releases
	     were built unsigned. -->
	<!-- Hardened Runtime: drive Spotify/Music via AppleScript. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
